# CloudStack Configuration
cloudstack_api_url    = "https://sky.runatlas.is/client/api"
cloudstack_api_key    = "your-api-key"
cloudstack_secret_key = "your-secret-key"

# SSH Access
ssh_public_key = "ssh-rsa AAAA..."

# HTTPS Configuration (leave empty for HTTP-only)
domain_name   = ""  # e.g., "example.com"
email_address = ""  # e.g., "you@example.com" (required if domain_name is set)

# Security (restrict for production)
ssh_allowed_ips = ["0.0.0.0/0"]

# Infrastructure (defaults are usually fine)
zone                      = "Atlas-alpha"
instance_service_offering = "Small Instance"
instance_template         = "Ubuntu 24.04 LTS"
network_offering          = "DefaultSharedNetworkOffering"
